# Use Node.js 22+. Keep all credentials server-side; never use NEXT_PUBLIC_ for keys.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_FALLBACK_MODEL="openai/gpt-oss-20b"
# Required for public AI endpoints and sharing; optional for local synthetic examples.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Set to the actual HTTPS deployment origin for public hosting.
APP_URL="http://localhost:3000"
AI_DAILY_REQUEST_LIMIT="200"
# Local production smoke testing only; keep false on public hosting.
ALLOW_LOCAL_RATE_LIMIT="false"
# Vercel is detected automatically. Set true only behind a trusted proxy that sets X-Forwarded-For.
TRUST_PROXY="false"
